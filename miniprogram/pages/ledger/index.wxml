<view class="page">
  <view class="eyebrow">MONEY IN MOTION</view><view class="title">分润明细</view><view class="muted">原始入账与冲正状态逐笔可查 · UTC</view>
  <picker mode="date" fields="month" value="{{month}}" bindchange="onMonth"><view class="pill spaced">{{month}} ▾</view></picker>
  <view class="tabs"><view class="pill {{role === '' ? 'active' : ''}}" data-role="" bindtap="onFilter">全部</view><view class="pill {{role === 'PROMOTER' ? 'active' : ''}}" data-role="PROMOTER" bindtap="onFilter">自己出单</view><view class="pill {{role === 'PARENT' ? 'active' : ''}}" data-role="PARENT" bindtap="onFilter">团队奖励 21%</view></view>
  <view class="card activity" wx:for="{{items}}" wx:key="id"><view class="icon">{{item.roleType === 'PROMOTER' ? '↗' : '◎'}}</view><view class="activity-main"><view class="strong">{{item.entryType === 'refund' ? '退款冲正' : item.roleType === 'PROMOTER' ? '自己出单' : '团队奖励'}}</view><view class="muted mono small">{{item.orderNo}}</view><view class="muted small">{{item.ratePercent}}% · {{item.settledAt}} · {{item.settlementStatus === 'REVERSED' ? '已冲正' : '已结算'}}</view></view><view class="gain mono {{item.entryType === 'refund' ? 'refund-amount' : item.settlementStatus === 'REVERSED' ? 'reversed-amount' : ''}}">{{item.entryType === 'refund' ? '−¥' : item.settlementStatus === 'REVERSED' ? '原 ¥' : '+¥'}}{{hidden ? '••••' : (item.displayAmount)}}</view></view>
  <view wx:if="{{error}}" class="error" bindtap="loadMore">{{error}} · 点击重试</view><view wx:elif="{{!loading && !items.length}}" class="empty">当前筛选下暂无记录</view>
  <button wx:if="{{page < totalPages}}" class="secondary" loading="{{loading}}" bindtap="loadMore">加载更早记录</button><view wx:else class="muted center">共 {{total}} 笔</view>
</view>
