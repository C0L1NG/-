<view class="page"><view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx"><view style="font-size:44rpx;font-weight:600">分润明细</view><picker mode="date" fields="month" value="{{month}}" bindchange="onMonth"><view class="card mono" style="margin:0;padding:16rpx 22rpx">{{month}}</view></picker></view>
<block wx:for="{{items}}" wx:key="id"><view class="card"><view style="display:flex;justify-content:space-between"><view>{{item.earningType === 'DOWNLINE_REWARD' ? '下级出单奖励' : '自己出单'}}</view><view class="mono" style="font-weight:600">+¥ {{item.commissionAmount}}</view></view><view class="label mono" style="display:flex;justify-content:space-between;margin-top:16rpx"><text>{{item.orderNo}}</text><text>{{item.ratePercent}}%</text></view></view></block><view wx:if="{{!items.length}}" class="empty">本月暂无分润</view></view>
