<view class="page"><view class="eyebrow">YOUR PEOPLE</view><view class="title">直属团队</view><view class="muted">仅本人直接发展的伙伴 · 贡献已剔除冲正订单</view>
<view class="card activity" wx:for="{{items}}" wx:key="id"><view class="avatar">{{item.displayName}}</view><view class="activity-main"><view class="strong">{{item.displayName}}</view><view class="muted small">加入时间 {{item.joinedAt}}</view></view><view class="gain mono">¥{{hidden ? '••••' : (item.contributionCommission)}}</view></view>
<view wx:if="{{error}}" class="error" bindtap="loadMore">{{error}} · 点击重试</view><view wx:elif="{{!loading && !items.length}}" class="empty">还没有直属伙伴</view><button wx:if="{{page < totalPages}}" class="secondary" loading="{{loading}}" bindtap="loadMore">加载更多成员</button><view wx:else class="muted center">共 {{total}} 人</view></view>
