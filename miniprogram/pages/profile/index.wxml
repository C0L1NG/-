<view class="page"><view class="eyebrow">YOUR ACCOUNT</view><view class="title">我的</view><view wx:if="{{loggedOut}}" class="card"><view class="muted">已安全退出</view><button class="button spaced" bindtap="login">微信重新登录</button></view><block wx:else><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="strong">{{overview.displayName || '代理伙伴'}}</view><view class="muted spaced">{{overview.currentCommissionRatePercent === 49 ? '二级合伙人' : '一级合伙人'}}</view></view><view class="card"><view class="eyebrow">YOUR INVITATION</view><view class="title small-title">直属代理邀请</view><view class="value mono gain">{{referral.referralCode || '—'}}</view><view class="muted spaced">{{overview.currentCommissionRatePercent === 49 ? '二级伙伴可出单，不再招募代理。' : '邀请直属二级伙伴，享受 21% 导师奖励。'}}</view><button wx:if="{{overview.currentCommissionRatePercent === 70}}" class="button spaced" bindtap="copy">复制专属邀请链接</button><button wx:if="{{overview.currentCommissionRatePercent === 70}}" class="secondary spaced" bindtap="poster">生成太阳码海报</button></view><view class="card"><view class="menu" bindtap="withdraw">收款绑定与提现记录 <text>→</text></view><view class="menu" bindtap="webLogin">生成网页登录码 <text>→</text></view><view class="menu" bindtap="logout">安全退出登录 <text>→</text></view></view></block></view>
