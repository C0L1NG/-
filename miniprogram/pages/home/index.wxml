<view class="page"><view class="identity"><view class="avatar"><image wx:if="{{overview.avatarUrl}}" src="{{overview.avatarUrl}}"/><text wx:else>合伙</text></view><view class="activity-main"><view class="eyebrow">PARTNER / 合伙人</view><view class="strong">{{overview.displayName || '代理伙伴'}}</view></view><view class="pill small">{{overview.currentCommissionRatePercent === 49 ? 'Lv.2' : 'Lv.1'}} 合伙人</view></view>
<view class="title spaced">账户总览</view>
<view wx:if="{{error}}" class="card error" bindtap="retry">{{error}} · 点击重新登录</view><view wx:elif="{{loading}}" class="card skeleton">正在加载账户…</view><block wx:else>
<view class="card hero"><view class="muted">我的可提现佣金</view><view class="balance" bindtap="toggleBalance">¥ {{hidden ? '••••••' : overview.balance}} <text class="eye">{{hidden ? '显示' : '隐藏'}}</text></view><view class="actions"><button class="button" bindtap="openSettlement">申请提现</button><button class="secondary" bindtap="openPoster">邀请伙伴</button></view><view class="muted small spaced">历史净收益 ¥{{hidden ? '••••' : overview.totalEarned}} · 今日净收益与待结算预计 ¥{{hidden ? '••••' : overview.todayEstimatedEarnings}}</view></view>
<view class="section-head"><view class="strong">最新分润</view><view class="gain small" bindtap="openLedger">查看全部 →</view></view>
<view wx:for="{{items}}" wx:key="id" class="card activity"><view class="icon">{{item.roleType === 'PROMOTER' ? '↗' : '◎'}}</view><view class="activity-main"><view class="strong">{{item.entryType === 'refund' ? '退款冲正' : item.roleType === 'PROMOTER' ? '自己出单' : '团队奖励'}}</view><view class="muted small">{{item.ratePercent}}% · {{item.settledAt}}</view></view><view class="gain mono {{item.entryType === 'refund' ? 'refund-amount' : item.settlementStatus === 'REVERSED' ? 'reversed-amount' : ''}}">{{item.entryType === 'refund' ? '−¥' : item.settlementStatus === 'REVERSED' ? '原 ¥' : '+¥'}}{{hidden ? '••••' : item.displayAmount}}</view></view><view wx:if="{{!items.length}}" class="empty">尚无已入账分润</view></block></view>
