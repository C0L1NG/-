@import "./design-tokens.wxss";
page { --app-bg: var(--agent-bg); --app-surface: var(--agent-surface); --app-raised: var(--agent-soft); --app-line: var(--agent-line); --app-text: var(--agent-text); --app-muted: var(--agent-muted); }
page { background: var(--app-bg); color: var(--app-text); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 40rpx 36rpx 80rpx; }
.card { margin-top: 24rpx; padding: 36rpx; border-radius: var(--radius-card); background: var(--app-surface); border: 1rpx solid var(--app-line); }
.eyebrow { font-size: 20rpx; color: var(--app-muted); letter-spacing: 2rpx; }
.title { font-size: 44rpx; font-weight: 600; letter-spacing: -1rpx; margin: 28rpx 0; }
.strong { font-size: 28rpx; font-weight: 600; }
.muted { color: var(--app-muted); font-size: 24rpx; line-height: 1.7; }
.mono { font-family: Menlo, Monaco, monospace; font-variant-numeric: tabular-nums; }
.value { font-size: 46rpx; font-weight: 600; margin-top: 22rpx; }
.gain { color: var(--positive); font-weight: 600; font-size: 28rpx; }
.small { font-size: 22rpx; }
.spaced { margin-top: 24rpx; }
.button, .secondary { min-height: 96rpx; line-height: 96rpx; border-radius: var(--radius-control); font-size: 26rpx; font-weight: 600; margin: 0; padding: 0 28rpx; }
.button { background: var(--action-bg); color: var(--action-text); }
.secondary { background: var(--app-raised); color: var(--app-text); border: 1rpx solid var(--app-line); }
button::after { border: 0; }
button[disabled] { opacity: .4; }
.pill { display: inline-block; border-radius: var(--radius-control); background: var(--app-raised); border: 1rpx solid var(--app-line); padding: 14rpx 22rpx; font-size: 24rpx; }
.active { background: var(--action-bg); color: var(--action-text); font-weight: 600; }
.tabs { display: flex; gap: 14rpx; margin: 24rpx 0; flex-wrap: wrap; }
.activity { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; }
.activity-main { flex: 1; min-width: 0; overflow: hidden; }
.icon, .avatar { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--app-raised); color: var(--positive); border: 1rpx solid var(--app-line); flex-shrink: 0; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-top: 48rpx; margin-bottom: 20rpx; }
.bento { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.bento .card { min-width: 0; overflow: hidden; }
.empty { padding: 70rpx 0; text-align: center; color: var(--app-muted); font-size: 26rpx; }
.error { color: var(--negative); padding: 28rpx; font-size: 26rpx; line-height: 1.6; }
.center { text-align: center; margin-top: 30rpx; }
.skeleton { color: var(--app-muted); min-height: 180rpx; }
.input { background: var(--app-bg); border: 1rpx solid var(--app-line); border-radius: 24rpx; padding: 28rpx; font-size: 26rpx; }
.menu { display: flex; justify-content: space-between; gap: 18rpx; padding: 28rpx 0; font-size: 25rpx; }
.children { border-left: 1rpx solid var(--app-line); padding-left: 24rpx; margin-top: 24rpx; }
.hero { padding: 40rpx; background: var(--app-surface); border-radius: var(--radius-card); }
.value, .balance, .gain { overflow-wrap: anywhere; word-break: break-all; }
.activity > .gain { max-width: 44%; text-align: right; }
.refund-amount { color: var(--negative); }
.reversed-amount { color: var(--app-muted); }
