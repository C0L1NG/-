<view class="page"><view class="eyebrow">NETWORK INTELLIGENCE</view><view class="title">团队网络</view><view class="muted">本月平台贡献排序 · UTC</view><view wx:for="{{items}}" wx:key="id" class="card"><view bindtap="toggle" data-id="{{item.id}}"><view class="section-head"><view class="strong">{{item.displayName}}</view><view class="gain">{{open === item.id ? '收起' : '展开'}} ↓</view></view><view class="menu">团队 GMV <text class="mono">¥{{item.teamGmv}}</text></view><view class="menu">平台贡献 <text class="mono gain">¥{{item.teamPlatformContribution}}</text></view><view class="muted">直属 {{item.teamSize}} 人 · 钱包 ¥{{item.balance}}</view></view><view wx:if="{{open === item.id}}" class="children"><view wx:for="{{children}}" wx:for-item="child" wx:key="id" class="activity"><view class="activity-main"><view class="strong">{{child.displayName}}</view><view class="muted small">{{child.ownOrderCount}} 笔 · ¥{{child.ownGmv}}</view></view><view class="gain mono">导师 ¥{{child.mentorPaidUp}}</view></view><view wx:if="{{childError}}" class="error" bindtap="children">{{childError}} · 重试</view><button wx:if="{{childPage < childTotalPages}}" class="secondary spaced" loading="{{childLoading}}" bindtap="children">加载二级成员</button></view></view><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 重试</view><button wx:if="{{page < totalPages}}" class="secondary spaced" loading="{{loading}}" bindtap="load">加载更多一级代理</button></view>
