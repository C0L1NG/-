<view class="page"><view class="eyebrow">CONSOLE / 管理中心</view><view class="title">资金总览</view><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 重试</view><view wx:elif="{{loading}}" class="card skeleton">正在加载大盘…</view><block wx:else><view class="card hero"><view class="muted">平台净收益池 · 固定 30%</view><view class="value mono">¥{{all.platformTotalRevenue}}</view><view class="pill gain spaced">已扣除退款冲正</view><button class="button spaced" bindtap="web">资金提现 / 对账</button></view><view class="card"><view class="strong">UTC 今日运行简报</view><view class="menu">平台净收益 <text class="mono gain">¥{{day.platformTotalRevenue}}</text></view><view class="menu">全网成单 <text class="mono">{{day.paidOrderCount}} 笔</text></view><view class="menu">活跃出单代理 <text class="mono">{{day.activePromoterCount}} 人</text></view></view><view class="card"><view class="menu">全网净成交 GMV <text class="mono">¥{{all.totalGmv}}</text></view><view class="menu">代理净分成 <text class="mono gain">¥{{all.agentCommissionPool}}</text></view><view class="menu">网络合伙人 <text>{{all.agentCount}} 人</text></view></view></block><button class="secondary spaced" bindtap="logout">安全退出</button></view>
