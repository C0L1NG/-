<view class="page"><view class="eyebrow">AUDIT LEDGER</view><view class="title">分润审计</view><view class="muted">原始分配保持可追溯，冲正单独标记。</view><view class="card" wx:for="{{items}}" wx:key="id"><view bindtap="toggle" data-id="{{item.id}}"><view class="strong mono">{{item.orderNo}}</view><view class="menu">利润池 X <text class="mono gain">¥{{item.profitAmount}}</text></view><view class="muted small">{{item.settlementStatus}} · {{item.createdAt}} ↓</view></view><view wx:if="{{open === item.id}}" class="children"><view class="menu">平台 30% <text class="mono gain">¥{{item.platform.amount || '—'}}</text></view><view class="menu">{{item.promoterCommission.recipientName || '出单人'}} {{item.promoterCommission.ratePercent || '—'}}% <text class="mono">¥{{item.promoterCommission.amount || '—'}}</text></view><view class="menu">{{item.mentorCommission.recipientName || '无直属导师'}} {{item.mentorCommission.ratePercent || 0}}% <text class="mono">¥{{item.mentorCommission.amount || '0.00'}}</text></view></view></view><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 重试</view><button wx:if="{{page < totalPages}}" class="secondary spaced" loading="{{loading}}" bindtap="load">加载更早订单</button></view>
