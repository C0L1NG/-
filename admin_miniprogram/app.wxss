page{background:#0A0A0A;color:#F5F5F5;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:48rpx 36rpx 70rpx}.card{margin-top:24rpx;padding:32rpx;border-radius:18rpx;background:#121212;border:1rpx solid rgba(255,255,255,.08)}.eyebrow{font-size:21rpx;color:#F5F5F5;letter-spacing:3rpx}.title{font-size:48rpx;font-weight:800;letter-spacing:-.5rpx;margin:22rpx 0}.strong{font-size:28rpx;font-weight:700}.muted{color:#949494;font-size:24rpx;line-height:1.7}.mono{font-family:Menlo,Monaco,monospace;font-variant-numeric:tabular-nums}.value{font-size:44rpx;font-weight:800;margin-top:24rpx}.gain{color:#20BF83;font-weight:700;font-size:28rpx}.small{font-size:22rpx}.spaced{margin-top:24rpx}.button,.secondary{height:96rpx;line-height:96rpx;border-radius:12rpx;font-size:27rpx;font-weight:700;margin:0;padding:0 28rpx}.button{background:#F5F5F5;color:#111111}.secondary{background:#242424;color:#F5F5F5;border:1rpx solid rgba(255,255,255,.08)}button::after{border:0}button[disabled]{opacity:.4;background:#242424;color:#949494}.pill{display:inline-block;border-radius:12rpx;background:#242424;border:1rpx solid rgba(255,255,255,.08);padding:16rpx 24rpx;font-size:24rpx}.active{background:#F5F5F5;color:#111111;font-weight:700}.tabs{display:flex;gap:14rpx;margin:24rpx 0;flex-wrap:wrap}.activity{display:flex;align-items:center;gap:22rpx;padding:28rpx}.activity-main{flex:1;min-width:0;overflow:hidden}.icon,.avatar{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#242424;color:#F5F5F5;border:1rpx solid rgba(255,255,255,.05);flex-shrink:0}.section-head{display:flex;align-items:center;justify-content:space-between;margin-top:52rpx;margin-bottom:20rpx}.bento{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.bento .card{min-width:0;overflow:hidden}.empty{padding:70rpx 0;text-align:center;color:#949494;font-size:26rpx}.error{color:#F36673;padding:28rpx;font-size:26rpx;line-height:1.6}.center{text-align:center;margin-top:30rpx}.skeleton{color:#949494;min-height:180rpx}.input{background:#0A0A0A;border:1rpx solid rgba(255,255,255,.08);border-radius:24rpx;padding:28rpx;font-size:26rpx}
.menu{display:flex;justify-content:space-between;gap:18rpx;padding:24rpx 0;font-size:25rpx}.children{border-left:1rpx solid #333333;padding-left:24rpx;margin-top:24rpx}.hero{background:#111111}

.value,.balance,.gain{overflow-wrap:anywhere;word-break:break-all}.activity{margin-top:0;border:0;border-bottom:1rpx solid #262626;border-radius:0;background:transparent;padding:30rpx 0}.gain{max-width:44%;text-align:right}.refund-amount{color:#F36673}.hero{border:0;border-bottom:1rpx solid #262626;border-radius:0;background:transparent;padding:36rpx 0}.title{font-weight:600}.eyebrow{color:#888888;letter-spacing:1rpx}
