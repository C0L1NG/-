DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/saas_distribution?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_ISSUER="saas-distribution"
JWT_AUDIENCE="agent-portal"
ADMIN_JWT_AUDIENCE="admin-portal"
AGENT_REFERRAL_BASE_URL="https://example.com/register"
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
PORT="3000"

# Separate owner mini-program credentials; never use the agent AppID for owner login.
ADMIN_WECHAT_APP_ID=""
ADMIN_WECHAT_APP_SECRET=""
# Shared with a trusted merchant gateway which first verifies the payment provider.
PAYMENT_WEBHOOK_SECRET=""
# Set false only for local HTTP development.
COOKIE_SECURE="true"

# Same random 32+ character secret in Next BFF and Python API; never NEXT_PUBLIC_.
BFF_CONTEXT_SECRET=""

# Container deployment: URL-encode the password; the hostname is database.
POSTGRES_PASSWORD=""
COMPOSE_DATABASE_URL="postgresql://commission_app:URL_ENCODED_APP_PASSWORD@database:5432/commission"
COMPOSE_MIGRATION_DATABASE_URL="postgresql://postgres:URL_ENCODED_OWNER_PASSWORD@database:5432/commission"
# Optional local migration-owner DSN, separate from the runtime DATABASE_URL.
MIGRATION_DATABASE_URL=""
