{
  "name": "saas-distribution-data-model",
  "private": true,
  "type": "module",
  "scripts": {
    "db:validate": "python_backend/.venv/bin/python python_backend/tools/migrate.py check",
    "db:deploy": "python_backend/.venv/bin/python python_backend/tools/migrate.py upgrade",
    "start": "cd python_backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT:-3000}",
    "start:agent": "cd python_backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT:-3000}",
    "start:legacy": "node scripts/legacy-disabled.mjs",
    "test": "node --import tsx --test scripts/tests/*.test.mjs miniprogram/tests/*.test.cjs",
    "test:python": "cd python_backend && .venv/bin/python -m pytest -q",
    "contract:generate": "python_backend/.venv/bin/python python_backend/tools/generate_ts_contracts.py && python_backend/.venv/bin/python python_backend/tools/generate_openapi.py",
    "contract:check": "python_backend/.venv/bin/python python_backend/tools/generate_ts_contracts.py --check && python_backend/.venv/bin/python python_backend/tools/generate_openapi.py --check",
    "showcase:sync": "node scripts/sync-showcase.mjs",
    "showcase:check": "node scripts/sync-showcase.mjs --check",
    "typecheck": "pnpm --dir web typecheck",
    "test:tooling": "pnpm test",
    "showcase:prepare": "node scripts/prepare-showcase.mjs",
    "format": "prettier --write web miniprogram admin_miniprogram scripts",
    "format:check": "prettier --check web miniprogram admin_miniprogram scripts",
    "db:adopt": "python_backend/.venv/bin/python python_backend/tools/migrate.py adopt-prisma",
    "design:generate": "python_backend/.venv/bin/python scripts/generate-design-tokens.py",
    "design:check": "python_backend/.venv/bin/python scripts/generate-design-tokens.py --check"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}
